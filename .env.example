# Copy this file to .env and fill in real values. Never commit the real .env
# file — it's already listed in .gitignore.

# Stripe (Developers → API keys in the Stripe Dashboard; use the "Secret key")
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (Developers → Webhooks → your endpoint →
# "Signing secret"). Only available once the endpoint is registered — see
# SETUP-STRIPE.md.
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (Project Settings → API). SUPABASE_SERVICE_ROLE_KEY is the SECRET
# service_role key — never the anon key, and never put it in any client-side
# file. It's only used here, server-side, so the webhook can mark an order
# paid after Stripe confirms it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Base URL Stripe should redirect back to after checkout (your deployed site).
# For local testing this can stay as localhost.
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
